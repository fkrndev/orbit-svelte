{
	"name": "orbit-lite",
	"private": true,
	"version": "0.1.3",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"start": "bun run build && electrobun dev",
		"dev": "concurrently -n vite,app \"bun run hmr\" \"bun run start\"",
		"dev:browser": "concurrently -n api,vite \"bun run api\" \"bun run hmr\"",
		"api": "bun run src/bun/devServer.ts",
		"hmr": "vite --port 5373",
		"build": "vite build && node scripts/relative-asset-paths.mjs",
		"build:canary": "bun run build && electrobun build --env=canary",
		"build:stable": "bun run build && electrobun build --env=stable",
		"release": "bash scripts/release.sh",
		"icons": "bash scripts/build-icons.sh",
		"sync": "electrobun sync",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^26",
		"concurrently": "^10.0.5",
		"electrobun": "2.0.1",
		"jsdom": "^30.0.1",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@floating-ui/dom": "^1.8.0",
		"@lezer/highlight": "^1.2.3",
		"@lucide/svelte": "^1.31.0",
		"@tiptap/core": "^3.30.1",
		"@tiptap/extension-bubble-menu": "^3.30.1",
		"@tiptap/extension-code-block-lowlight": "^3.30.1",
		"@tiptap/extension-drag-handle": "^3.30.1",
		"@tiptap/extension-highlight": "^3.30.1",
		"@tiptap/extension-image": "^3.30.1",
		"@tiptap/extension-list": "^3.30.1",
		"@tiptap/extension-mathematics": "^3.30.1",
		"@tiptap/extension-subscript": "^3.30.1",
		"@tiptap/extension-superscript": "^3.30.1",
		"@tiptap/extension-table": "^3.30.1",
		"@tiptap/extension-table-of-contents": "^3.30.1",
		"@tiptap/extension-text-align": "^3.30.1",
		"@tiptap/extension-text-style": "^3.30.1",
		"@tiptap/extension-typography": "^3.30.1",
		"@tiptap/extension-unique-id": "^3.30.1",
		"@tiptap/extensions": "^3.30.1",
		"@tiptap/markdown": "^3.30.1",
		"@tiptap/pm": "^3.30.1",
		"@tiptap/starter-kit": "^3.30.1",
		"@tiptap/suggestion": "^3.30.1",
		"bits-ui": "^2.18.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"dompurify": "3.4.2",
		"katex": "^0.17.0",
		"lowlight": "^3.3.0",
		"mermaid": "^11.16.1",
		"safe-regex2": "^5.1.1",
		"tailwind-merge": "^3.6.0"
	}
}
